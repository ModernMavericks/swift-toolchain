# pins.env — single source of truth for every pinned input.
# Sourced by build-llvm.sh, mirror-toolchain.sh, package.sh, verify-relocatable.sh.
# Do NOT float these: the Swift stdlib is coupled to its compiler.
SWIFT_VERSION="6.3.3"
SWIFT_TAG="swift-6.3.3-RELEASE"
SWIFT_SHA="064859e41d68596f486c5d724401cb370f260409"          # swiftlang/swift @ swift-6.3.3-RELEASE
LLVM_BRANCH="swift/release/6.3"
LLVM_SHA="82cdc19fa54d566969527b56f587ea8ea30bef51"           # swiftlang/llvm-project @ swift/release/6.3
TOOLCHAIN_URL="https://download.swift.org/swift-6.3.3-release/xcode/swift-6.3.3-RELEASE/swift-6.3.3-RELEASE-osx.pkg"
TOOLCHAIN_SHA256="ee82e57774d6650f94aa06302435d6f44a055b9411698db8ecb85d9a3bcc91d0"
DEPLOYMENT="10.9"
ARCH="x86_64"
HOST_ARCH="$(uname -m)"                                      # labels the tarball; must describe the machine that built it

# ---- derived asset names -----------------------------------------------------
# Defined ONCE here because package.sh writes these names and verify-relocatable.sh
# reads them back; computing them separately in each script is how the two silently
# drift apart. Requires the sourcing script to have set HERE (all of them do).
VERSION="$(cat "$HERE/VERSION")"
# Built here, so it carries the repo name and version: <repo>-<VERSION>-<platform>.
# The platform suffix is load-bearing -- HOST_ARCH describes the machine that built
# the TableGen binaries, and an arm64 tree labelled x86_64 fails confusingly.
BUILDSUPPORT_ASSET="swift-toolchain-$VERSION-macos-$HOST_ARCH.tar.gz"
# Mirrored, not built: keeps upstream's filename so the correspondence with
# download.swift.org stays checkable, prefixed to make its nature obvious.
TOOLCHAIN_ASSET="upstream-swift-$SWIFT_VERSION-RELEASE-osx.pkg"
